# Lexicon Weaver — backend configuration template.
# Скопируйте этот файл в `.env` и заполните значения.
# Файл `.env` исключён из git (см. .gitignore) — секреты в репозиторий не попадают.

# --- База данных и CORS ---------------------------------------------------
LW_DATABASE_URL=sqlite:///./lexicon_weaver.db
LW_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Stepik OAuth ---------------------------------------------------------
# Зарегистрируйте приложение на https://stepik.org/oauth2/applications/
# (Authorization grant type = "Client credentials"), скопируйте Client ID и
# Client Secret сюда. Без них доступен только импорт из JSON-дампа
# (source=mock / source=json); прямой source=stepik вернёт 503.
LW_STEPIK_CLIENT_ID=
LW_STEPIK_CLIENT_SECRET=
LW_STEPIK_OAUTH_URL=https://stepik.org/oauth2/token/
LW_STEPIK_API_BASE=https://stepik.org/api
